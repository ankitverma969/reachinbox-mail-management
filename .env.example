# ==============================================================================
# ReachInbox Email Scheduler - Root Environment Template
# Note: Copy to .env for local development. Never commit .env with real secrets.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
# FRONTEND_URL must be an exact, fully qualified HTTP/HTTPS URL (NEVER a wildcard like *.vercel.app)
# Local: http://localhost:5173 | Production: https://reachinboxai4u.vercel.app
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Docker or Local)
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public

# Redis Broker (BullMQ & Atomic Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Full-Text Search
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# Worker & Throttling Defaults
EMAIL_WORKER_CONCURRENCY=5
MIN_EMAIL_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Slack OAuth 2.0 & Webhook Integration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:5000/api/v1/integrations/slack/callback

# Ethereal Email Sandbox Credentials (Mock SMTP)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user@ethereal.email
ETHEREAL_PASSWORD=your-ethereal-password

# Security & Symmetric Secret Storage (AES-256-GCM)
JWT_SECRET=super_secret_jwt_signing_key_minimum_32_characters_long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
