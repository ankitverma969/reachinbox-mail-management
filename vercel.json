{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://52.23.237.61:5000/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "http://52.23.237.61:5000/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
