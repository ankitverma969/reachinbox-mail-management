# Server Configuration
NODE_ENV=development
PORT=5000
# FRONTEND_URL must be an exact, fully qualified HTTP/HTTPS URL (NEVER a wildcard like *.vercel.app)
# Local: http://localhost:5173 | Production: https://reachinboxai4u.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional alternative: CORS_ORIGIN=https://reachinboxai4u.vercel.app

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public

# Redis Connection (BullMQ & Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Full-Text Search
ELASTICSEARCH_URL=http://localhost:9200

# Worker Settings
EMAIL_WORKER_CONCURRENCY=5
MIN_EMAIL_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Slack OAuth 2.0 Integration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:5000/api/v1/integrations/slack/callback

# Ethereal Email Credentials
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user@ethereal.email
ETHEREAL_PASSWORD=your-ethereal-password

# Encryption & JWT
JWT_SECRET=super_secret_jwt_signing_key_minimum_32_characters_long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Dedicated Bull Board Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=reachinbox_admin_secure_pass
ADMIN_API_KEY=admin_api_key_for_testing
