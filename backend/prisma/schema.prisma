// ReachInbox Email Job Scheduler - Prisma Schema
// Single source of truth for relational data models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailJobStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED_RESCHEDULED
  CANCELLED
}

enum DeliveryAttemptStatus {
  SUCCESS
  TEMPORARY_FAILURE
  PERMANENT_FAILURE
  RATE_LIMITED
}

model User {
  id                String              @id @default(uuid())
  googleId          String              @unique @map("google_id")
  email             String              @unique
  name              String
  avatarUrl         String?             @map("avatar_url")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  senders           SenderIdentity[]
  batches           EmailBatch[]
  slackIntegrations SlackIntegration[]

  @@map("users")
}

model SenderIdentity {
  id                    String              @id @default(uuid())
  userId                String              @map("user_id")
  emailAddress          String              @map("email_address")
  displayName           String              @map("display_name")
  smtpHost              String              @map("smtp_host")
  smtpPort              Int                 @default(587) @map("smtp_port")
  smtpUsername          String              @map("smtp_username")
  smtpPasswordEncrypted String              @map("smtp_password_encrypted")
  hourlyRateLimit       Int                 @default(200) @map("hourly_rate_limit")
  minDelaySeconds       Int                 @default(2) @map("min_delay_seconds")
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  batches               EmailBatch[]
  emailJobs             EmailJob[]
  rateLimitAuditLogs    RateLimitAuditLog[]

  @@index([userId], name: "idx_sender_user_id")
  @@map("sender_identities")
}

model EmailBatch {
  id                     String         @id @default(uuid())
  userId                 String         @map("user_id")
  senderId               String         @map("sender_id")
  originalFilename       String?        @map("original_filename")
  totalLeadsDetected     Int            @default(0) @map("total_leads_detected")
  scheduledStartTime     DateTime       @map("scheduled_start_time")
  configuredDelaySeconds Int            @default(2) @map("configured_delay_seconds")
  createdAt              DateTime       @default(now()) @map("created_at")

  user                   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  sender                 SenderIdentity @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emailJobs              EmailJob[]

  @@index([userId], name: "idx_batch_user_id")
  @@index([senderId], name: "idx_batch_sender_id")
  @@map("email_batches")
}

model EmailJob {
  id                 String                 @id @default(uuid())
  batchId            String?                @map("batch_id")
  senderId           String                 @map("sender_id")
  recipientEmail     String                 @map("recipient_email")
  subject            String                 @db.VarChar(500)
  body               String                 @db.Text
  status             EmailJobStatus         @default(SCHEDULED)
  scheduledAt        DateTime               @map("scheduled_at")
  sentAt             DateTime?              @map("sent_at")
  failedAt           DateTime?              @map("failed_at")
  rescheduledAt      DateTime?              @map("rescheduled_at")
  retryCount         Int                    @default(0) @map("retry_count")
  idempotencyKey     String                 @unique @map("idempotency_key")
  bullmqJobId        String?                @map("bullmq_job_id")
  smtpMessageId      String?                @map("smtp_message_id")
  etherealPreviewUrl String?                @map("ethereal_preview_url")
  errorMessage       String?                @map("error_message")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  sender             SenderIdentity         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  batch              EmailBatch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  deliveryAttempts   EmailDeliveryAttempt[]

  @@index([status, scheduledAt], name: "idx_email_job_status_scheduled_at")
  @@index([senderId, status], name: "idx_email_job_sender_status")
  @@index([sentAt], name: "idx_email_job_sent_at")
  @@index([bullmqJobId], name: "idx_email_job_bullmq_id")
  @@map("email_jobs")
}

model EmailDeliveryAttempt {
  id            String                @id @default(uuid())
  emailJobId    String                @map("email_job_id")
  attemptNumber Int                   @map("attempt_number")
  status        DeliveryAttemptStatus
  attemptedAt   DateTime              @default(now()) @map("attempted_at")
  durationMs    Int?                  @map("duration_ms")
  smtpResponse  String?               @map("smtp_response")
  smtpMessageId String?               @map("smtp_message_id")
  errorMessage  String?               @map("error_message")
  errorCode     String?               @map("error_code")

  emailJob      EmailJob              @relation(fields: [emailJobId], references: [id], onDelete: Cascade)

  @@index([emailJobId, attemptNumber], name: "idx_delivery_attempt_job_num")
  @@map("email_delivery_attempts")
}

model SlackIntegration {
  id                          String   @id @default(uuid())
  userId                      String   @map("user_id")
  slackTeamId                 String   @map("slack_team_id")
  slackTeamName               String   @map("slack_team_name")
  botUserId                   String   @map("bot_user_id")
  botTokenEncrypted           String   @map("bot_token_encrypted")
  incomingWebhookUrlEncrypted String?  @map("incoming_webhook_url_encrypted")
  defaultChannelId            String   @map("default_channel_id")
  defaultChannelName          String   @map("default_channel_name")
  isConnected                 Boolean  @default(true) @map("is_connected")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slackTeamId], name: "uq_user_slack_team")
  @@index([userId], name: "idx_slack_user_id")
  @@map("slack_integrations")
}

model RateLimitAuditLog {
  id                String         @id @default(uuid())
  senderId          String         @map("sender_id")
  hourWindow        String         @map("hour_window")
  quotaLimit        Int            @map("quota_limit")
  totalJobsDeferred Int            @default(1) @map("total_jobs_deferred")
  slackAlertSent    Boolean        @default(false) @map("slack_alert_sent")
  slackError        String?        @map("slack_error")
  createdAt         DateTime       @default(now()) @map("created_at")

  sender            SenderIdentity @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, hourWindow], name: "uq_rate_limit_sender_window")
  @@index([senderId, hourWindow], name: "idx_rate_limit_sender_window")
  @@map("rate_limit_audit_logs")
}

enum OutboxEventType {
  INDEX_JOB
  UPDATE_STATUS
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model IndexingOutbox {
  id          String          @id @default(uuid())
  emailJobId  String          @map("email_job_id")
  eventType   OutboxEventType @map("event_type")
  payload     Json
  status      OutboxStatus    @default(PENDING)
  retryCount  Int             @default(0) @map("retry_count")
  maxRetries  Int             @default(5) @map("max_retries")
  lastError   String?         @map("last_error")
  nextRetryAt DateTime?       @map("next_retry_at")
  processedAt DateTime?       @map("processed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status, nextRetryAt], name: "idx_indexing_outbox_status_retry")
  @@index([emailJobId], name: "idx_indexing_outbox_job_id")
  @@map("indexing_outbox")
}
