# ReachInbox Frontend Environment Configuration
# Local development default:
VITE_API_BASE_URL=http://localhost:5000

# Note for Vercel deployment:
# Leave VITE_API_BASE_URL empty in Vercel project settings.
# When empty, the app uses relative paths ('/api') which Vercel's edge rewrite proxy (in vercel.json)
# forwards directly to http://52.23.237.61:5000, preventing browser Mixed Content blocking.
